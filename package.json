{
  "name": "honopress",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build:css": "bunx tailwindcss -i ./src/main.css -o ./public/main.css --minify",
    "dev:css": "bunx tailwindcss -i ./src/main.css -o ./public/css/main.css --watch",
    "build": "bun build src/index.ts --target=bun",
    "deploy": "npm run build:css && wrangler deploy",
    "dev:cf": "wrangler dev"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.3",
    "hono": "^4.6.8",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.11.10",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2"
  }
}